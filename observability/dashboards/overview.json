{
  "name": "overview",
  "description": "AllowMe MCP — tool call volume, p95 latency, error rate over 24h",
  "refresh": 60,
  "version": "1.0.0",
  "sprint": "4.0.2",
  "panels": [
    {
      "id": "tool_calls_24h",
      "title": "Tool calls — 24h",
