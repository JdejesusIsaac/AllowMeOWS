  "description": "OWS-native MCP server for family allowance management — achievement-gated USDC distribution with 5-role RBAC",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:http": "bun app/server.ts",
