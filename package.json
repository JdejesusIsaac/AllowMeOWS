    "@types/qrcode": "^1.5.6",
    "@types/string-similarity": "^4.0.2",
    "ai": "^6.0.146",
    "aixyz": "^0.19.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "string-similarity": "^4.0.4",
    "viem": "^2.23.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
