      "timeRange": "24h"
    },
    {
      "id": "tool_p95_24h",
      "title": "Tool p95 latency — 24h",
      "type": "line",
      "query": "tool_p95_24h",
      "groupBy": ["tool.name"],
      "timeRange": "24h"
    },
    {
      "id": "error_rate_24h",
      "title": "Tool error rate — 24h",
      "type": "stacked-bar",
      "query": "error_rate_24h",
      "groupBy": ["tool.name"],
      "timeRange": "24h"
    }
  ]
}
