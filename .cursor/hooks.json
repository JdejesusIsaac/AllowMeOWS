{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "python3 .cursor/hooks/phase-state-writer.py",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "matcher": "Write|Edit|ApplyPatch",
        "command": "python3 .cursor/hooks/artifact-budget-guard.py",
        "timeout": 5,
        "failClosed": true
      },
      {
        "matcher": "Write|Edit|ApplyPatch",
        "command": "python3 .cursor/hooks/spike-gate.py",
        "timeout": 5,
        "failClosed": true
      },
      {
        "matcher": "Write|Edit|ApplyPatch",
        "command": "python3 .cursor/hooks/failure-check.py",
        "timeout": 5
      }
    ],
    "beforeReadFile": [
      {
        "command": "python3 .cursor/hooks/evaluator-isolation.py",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python3 .cursor/hooks/mcp-phase-router.py",
        "timeout": 5,
        "failClosed": true
      }
    ]
  }
}
